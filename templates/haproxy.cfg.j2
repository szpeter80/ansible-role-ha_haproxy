# Configuration for HAProxy 3.0.5 as included in RHEL 10.2
# https://docs.haproxy.org/3.0/configuration.html
# 
# Known bugs: https://www.haproxy.org/bugs/bugs-3.0.html 

global
    log         /rsyslog-socket {{ ha_haproxy_syslog_facility }}

    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     100000
    user        haproxy
    group       haproxy
    daemon

    # turn on stats unix socket
    stats socket /var/lib/haproxy/stats

    # utilize system-wide crypto-policies
    ssl-default-bind-ciphers PROFILE=SYSTEM
    ssl-default-server-ciphers PROFILE=SYSTEM

#---------------------------------------------------------------------
# defaults for every 'listen' and 'backend' 
#---------------------------------------------------------------------
defaults
    mode                    http
    log                     global
    option                  tcplog
    option                  dontlognull
    option                  http-server-close
    option                  log-health-checks
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 100000

resolvers haproxy_dns
    parse-resolv-conf
    # allow larger DNS payloads
    accepted_payload_size 65000 

listen stats
    bind :{{ ha_haproxy_stat_port }}
    mode http
    stats enable
    stats show-node
    stats show-legends
    stats uri {{ ha_haproxy_stat_uri }}
    stats refresh 10s

listen ocp_kubernetes_api
    bind lb-vip.ocp.example.com:6443

    mode tcp
    balance roundrobin
    option httpchk GET /readyz HTTP/1.0
 
    server      bootstrap     bootstrap.ocp.example.com:6443   resolvers haproxy_dns init-addr none  verify none check check-ssl inter 10s fall 2 rise 3
    server      master1       master1.ocp.example.com:6443     resolvers haproxy_dns init-addr none  verify none check check-ssl inter 10s fall 2 rise 3
    server      master2       master2.ocp.example.com:6443     resolvers haproxy_dns init-addr none  verify none check check-ssl inter 10s fall 2 rise 3
    server      master3       master3.ocp.example.com:6443     resolvers haproxy_dns init-addr none  verify none check check-ssl inter 10s fall 2 rise 3

frontend ocp_machine_config_server
    bind lb-vip.ocp.example.com:22623

    mode tcp
    balance roundrobin

    server      bootstrap     bootstrap.ocp.example.com:22623   resolvers haproxy_dns  init-addr none  check  inter 1 s
    server      master1       master1.ocp.example.com:22623     resolvers haproxy_dns  init-addr none  check  inter 1 s
    server      master2       master2.ocp.example.com:22623     resolvers haproxy_dns  init-addr none  check  inter 1 s
    server      master3       master3.ocp.example.com:22623     resolvers haproxy_dns  init-addr none  check  inter 1 s

# Ingress can be on masters (compact cluster), on some or all workers, or on dedicated infra nodes
frontend ocp_http_ingress
    bind lb-vip.ocp.example.com:80

    mode tcp
    balance source
    option httpchk
    http-check connect
    http-check send meth GET uri /healthz/ready
    http-check expect status 200

    server      master1       master1.ocp.example.com:80     resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3
    server      master2       master2.ocp.example.com:80     resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3
    server      master3       master3.ocp.example.com:80     resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3
    server      infra1        infra1.ocp.example.com:80      resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3
    server      worker1       worker1.ocp.example.com:80     resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3

frontend ocp_https_ingress
    bind lb-vip.ocp.example.com:443

    mode tcp
    balance source
    option httpchk
    http-check connect
    http-check send meth GET uri /healthz/ready
    http-check expect status 200

    server      master1       master1.ocp.example.com:443      resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3
    server      master2       master2.ocp.example.com:443      resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3
    server      master3       master3.ocp.example.com:443      resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3
    server      infra1        infra1.ocp.example.com:443       resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3
    server      worker1       worker1.ocp.example.com:443      resolvers haproxy_dns  init-addr none  check  port 1936 inter 10s fall 2 rise 3