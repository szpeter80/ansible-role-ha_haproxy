global_defs {
}

vrrp_script chk_haproxy {
    script "/usr/bin/killall -0 haproxy"
    interval 2   # seconds
    weight 2     # integer to deduct if check fail
}
{% for entry in ha_haproxy_cfg %}
vrrp_instance VI_{{ loop.index }} {
    interface {{ ansible_default_ipv4.interface }}

    state {{ 'MASTER' if entry.keepalived_primary_host == inventory_hostname else 'BACKUP' }}
    priority {{ '101' if entry.keepalived_primary_host == inventory_hostname else '100' }}

    advert_int 1
    virtual_router_id {{ 90 + loop.index0 }}

    authentication {
        auth_type PASS
        auth_pass {{ entry.vrrp_password }}
    }

    virtual_ipaddress {
        {{ entry.vip_ip }}
    }

    unicast_src_ip {{ ansible_default_ipv4.address }}
    unicast_peer {
    {# printing all ips in the group except the actual managed host #}
    {%- for host in groups['g_ha_haproxy'] %}
    {%- if hostvars[host]['ansible_default_ipv4']['address'] != ansible_default_ipv4.address %}
      {{ hostvars[host]['ansible_default_ipv4']['address'] }}
    {%- endif %}
    {%- endfor %}
    }

    track_script {
        chk_haproxy
    }
}
{% endfor %}
