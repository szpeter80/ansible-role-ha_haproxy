---
# yamllint config for this role.
# line-length relaxed from the 80-char default: the longest lines are
# generated-artifact content (rsyslog config, SELinux policy, command
# lines) where wrapping would change the output or hurt readability.
# The other rule overrides are the set ansible-lint requires of a
# custom yamllint config.
extends: default

rules:
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  line-length:
    max: 120
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
